{
  "name": "signrelay",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "npm ci",
    "build:worker": "esbuild workers/recognition.worker.ts workers/template-matching.worker.ts workers/rsl.worker.ts workers/bdsl.worker.ts --bundle --format=esm --platform=browser --target=es2020 --outdir=public/workers && esbuild workers/asl-v3-tracker.worker.ts --bundle --format=iife --platform=browser --target=es2022 --outfile=public/workers/asl-v3-tracker.worker.js && node scripts/copy-onnx-runtime.mjs && node scripts/install-vision-assets.mjs --wasm-only",
    "install:rsl-model": "node scripts/install-rsl-model.mjs",
    "dev": "npm run build:worker && npm run install:vision-assets && node scripts/dev.mjs",
    "build": "npm run build:firebase",
    "build:firebase": "node scripts/build-profile.mjs full",
    "start": "node scripts/serve-export.mjs",
    "test": "vitest run",
    "test:rendered": "node --test tests/rendered-html.test.mjs",
    "audit:secrets": "node scripts/audit-secrets.mjs",
    "audit:deps": "node scripts/audit-dependencies.mjs",
    "audit:security": "npm audit --audit-level=moderate && npm run audit:secrets && npm run test:rendered",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern out --ignore-pattern .sites-runtime",
    "typecheck": "tsc --noEmit",
    "repo:guard": "node scripts/check-large-assets.mjs",
    "eval:live": "node scripts/summarize-live-evaluation.mjs",
    "eval:log": "node scripts/live-trial-log.mjs",
    "install:vision-assets": "node scripts/install-vision-assets.mjs",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "build:asl-demo": "node scripts/build-profile.mjs asl-demo",
    "demo:prepare": "node scripts/demo.mjs prepare",
    "demo:serve": "node scripts/demo.mjs serve",
    "demo:check": "node scripts/demo.mjs check",
    "demo": "npm run demo:prepare && npm run demo:serve",
    "build:rehearsal": "node scripts/build-profile.mjs rehearsal",
    "readiness": "node scripts/readiness.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "lucide-react": "^0.468.0",
    "next": "16.4.6",
    "onnxruntime-web": "^1.23.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "fast-glob": "file:tooling/fast-glob-shim",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.12"
  },
  "type": "module",
  "displayName": "SignRelay"
}
