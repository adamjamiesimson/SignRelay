{
  "name": "signrelay",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "npm ci",
    "build:worker": "esbuild workers/recognition.worker.ts workers/rsl.worker.ts --bundle --format=esm --platform=browser --target=es2020 --outdir=public/workers && node scripts/copy-onnx-runtime.mjs",
    "install:rsl-model": "node scripts/install-rsl-model.mjs",
    "dev": "npm run build:worker && node scripts/dev.mjs",
    "build": "npm run build:firebase",
    "build:firebase": "npm run install:rsl-model && node scripts/prepare-export.mjs && npm run build:worker && next build && node scripts/secure-export.mjs",
    "start": "node scripts/serve-export.mjs",
    "test": "vitest run",
    "test:rendered": "node --test tests/rendered-html.test.mjs",
    "audit:secrets": "node scripts/audit-secrets.mjs",
    "audit:security": "npm audit --audit-level=moderate && npm run audit:secrets && npm run test:rendered",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern out --ignore-pattern .sites-runtime"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.22-rc.20250304",
    "lucide-react": "^0.468.0",
    "next": "16.3.4",
    "onnxruntime-web": "^1.23.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  },
  "type": "module",
  "displayName": "SignRelay"
}
